# ==============================================================================
# Supabase Konfiguration für Arslan AI (Projekt: yy-ai-platform)
# ==============================================================================
SUPABASE_URL=https://<deine-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<dein-service-role-key>

# ==============================================================================
# KI-Verkaufsberater (Arslan) - Modell-Konfiguration (rein serverseitig)
# 
# OPTION A (Empfohlen): Google Gemini 3.8 Flash (Ersatz: 3.5 Flash-Lite)
# - Extrem geringe Kosten, kostenloses Kontingent verfügbar (Google AI Studio)
# - Antwortzeiten < 1 Sekunde
# ==============================================================================
GEMINI_API_KEY=dein-google-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# Ersatzmodell bei 404, 429, Timeout oder Serverfehlern des Primärmodells
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# OPTION B: OpenAI gpt-4o-mini (alternativ oder als automatische Ausweichlösung,
# falls Gemini nicht erreichbar ist)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
