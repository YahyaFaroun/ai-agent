# ==============================================================================
# Supabase Konfiguration für Arslan AI (Projekt: yy-ai-platform)
# 
# SICHERHEITSARCHITEKTUR:
# - Die Tabelle 'arslan_leads' ist über RLS vollständig für öffentliche Zugriffe ('anon') gesperrt.
# - Der Schreibzugriff erfolgt AUSSCHLIESSLICH serverseitig in der Next.js API-Route (/api/inquiries).
# - Der SUPABASE_SERVICE_ROLE_KEY verbleibt rein serverseitig in Vercel Environment Variables
#   und gelangt NIEMALS in den Browser oder in das Frontend.
# ==============================================================================

# URL deines neuen Supabase-Projekts "yy-ai-platform"
SUPABASE_URL=https://<deine-project-ref>.supabase.co

# Geheimer Service-Role-Schlüssel (Supabase Dashboard -> Project Settings -> API -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY=<dein-service-role-key>
