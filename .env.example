# ==============================================================================
# Supabase Konfiguration für Arslan AI (Projekt: yy-ai-platform)
# ==============================================================================
SUPABASE_URL=https://<deine-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<dein-service-role-key>

# ==============================================================================
# KI-Verkaufsberater (Arslan) - Modell-Konfiguration (rein serverseitig)
# 
# OPTION A (Empfohlen): Google Gemini 1.5 Flash / 2.0 Flash
# - Extrem geringe Kosten (ca. 0,075 $ / 1M Input-Tokens)
# - Kostenloses Kontingent verfügbar (Google AI Studio)
# - Antwortzeiten < 1 Sekunde
# ==============================================================================
GEMINI_API_KEY=dein-google-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# OPTION B: OpenAI gpt-4o-mini (alternativ)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
